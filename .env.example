# Omon Gateway configuration
# Copy this file to .env and replace placeholder values. Never commit .env.

# Discord
# A token from the Discord Developer Portal. Required unless
# DISCORD_BOT_TOKENS provides at least one token.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Optional comma-separated bot tokens. Each identity runs in the same process,
# enabling parallel multi-bot sharding. Tokens from both settings are combined.
DISCORD_BOT_TOKENS=

# Optional comma-separated Discord user IDs. When empty, all users may interact
# with the gateway. Set this in shared or public servers.
DISCORD_ALLOWED_USERS=

# Optional comma-separated Discord role IDs allowed to interact with the bot.
DISCORD_ALLOWED_ROLES=

# When true, all users are authorized, bypassing DISCORD_ALLOWED_USERS and
# DISCORD_ALLOWED_ROLES checks (default false).
DISCORD_ALLOW_ALL_USERS=false

# Optional comma-separated channel IDs where the bot responds without a mention.
# Direct messages and thread messages are handled automatically.
DISCORD_FREE_RESPONSE_CHANNELS=

# Optional comma-separated home channel IDs. Home channels are also treated as
# free-response channels.
DISCORD_HOME_CHANNEL=

# Optional comma-separated Discord channel IDs. When set, only messages in
# these guild channels are processed (whitelist). Direct messages are exempt.
# The same list is also the explicit cross-channel allowlist for message_context.
DISCORD_ALLOWED_CHANNELS=

# Optional comma-separated Discord channel IDs to ignore completely (blacklist).
# Messages in these channels are never processed or readable through message_context.
DISCORD_IGNORED_CHANNELS=

# When true, @-mentions in guild text channels automatically create a public
# thread and route the conversation there (default false).
DISCORD_AUTO_THREAD=false

# When true (default), conversation sessions in threads are partitioned per user.
# When false, all participants in a thread share the same conversation session.
DISCORD_THREAD_SESSIONS_PER_USER=true

# When true, requires an @-mention to respond even in active bot threads (default false).
DISCORD_THREAD_REQUIRE_MENTION=false

# When true, @-mentions in guild channels fetch recent preceding messages
# as conversational background context (default false).
DISCORD_CHANNEL_CONTEXT=false

# Maximum number of preceding channel messages to backfill when
# DISCORD_CHANNEL_CONTEXT is enabled (default 10, maximum 25).
DISCORD_CHANNEL_CONTEXT_LIMIT=10

# When true, fetches channel topic and forum parent description as conversation context (default false).
DISCORD_CHANNEL_TOPIC_CONTEXT=false

# Optional JSON mapping of channel IDs to custom system prompts and skill bundles:
# DISCORD_CHANNEL_PROMPTS='{"123456789": {"system_prompt": "Specialized assistant", "skills": ["web", "terminal"]}}'
DISCORD_CHANNEL_PROMPTS=

# Optional JSON array of profile-based hierarchical routing rules mapping
# (guild, channel, thread) scopes to custom models, system prompts, and toolsets.
# Matching precedence (most specific wins): thread > channel > guild.
# DISCORD_PROFILE_ROUTES='[{"guild":123,"channel":456,"thread":null,"model":"gpt-4o-mini","system_prompt":"Specialized coding assistant","toolsets":["terminal","web"]}]'

# When true (default), adds (i/N) pagination indicators to messages split across multiple chunks.
DISCORD_CHUNK_PAGINATION=true

# When true, appends a compact runtime metadata footer (`model · context% · cwd`) to the final assistant message (default false).
DISCORD_RUNTIME_FOOTER=false

# When true (default), adds 👀 reaction when processing starts, swapping to ✅ on success or ❌ on failure.
DISCORD_PROCESSING_REACTIONS=true

# When true (default), prepends a temporal message timestamp like [Tue 2026-04-28 13:40:53 UTC] to user turns for model awareness (replay-safe).
DISCORD_MESSAGE_TIMESTAMPS=true

# When true, scans recent channel history on boot for messages missed while the gateway was offline (default false).
DISCORD_MISSED_BACKFILL=false

# message_context Policy Matrix
# These values form the environment defaults. A persisted per-platform override
# in SQLite (`messenger_policy_overrides`) may replace the matrix at runtime.
# Current-session authorization is inherited from the already-authorized gateway session.
OMON_MESSAGE_CONTEXT_ALLOW_CURRENT=true
OMON_MESSAGE_CONTEXT_ALLOW_DM=true

# Enables the cross-channel capability, but does NOT make it open-ended:
# a target must still be explicitly listed in DISCORD_ALLOWED_CHANNELS.
OMON_MESSAGE_CONTEXT_ALLOW_CROSS_CHANNEL=true

# When true, an explicitly allowed cross-channel target must still resolve to
# the same Discord guild/workspace as the current session.
OMON_MESSAGE_CONTEXT_SAME_WORKSPACE_ONLY=true

# Fail closed if disabled: message_context will not trust the routed session's
# existing user/role/pairing authorization.
OMON_MESSAGE_CONTEXT_INHERIT_SESSION_AUTHORIZATION=true

# Per-operation hard policy ceilings. Tool arguments can request lower values,
# but cannot exceed these effective policy limits.
OMON_MESSAGE_CONTEXT_MAX_RECENT=50
OMON_MESSAGE_CONTEXT_MAX_SEARCH_RESULTS=50
OMON_MESSAGE_CONTEXT_MAX_SEARCH_SCAN=500
OMON_MESSAGE_CONTEXT_MAX_REPLIES=50

# LLM
# Required model identifier. Models beginning with "claude" use the Anthropic
# provider; all other model names use the OpenAI-compatible provider.
DEFAULT_MODEL=gpt-4o

# Optional OpenAI-compatible API endpoint. Leave empty for the provider default.
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI or OpenAI-compatible API key. Required when the selected provider needs
# bearer-token authentication.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional Anthropic API endpoint. Leave empty for the provider default.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Anthropic API key. Required when DEFAULT_MODEL begins with "claude".
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Bot handling policy: "none" (default, ignore bot authors), "mentions" (respond only when @-mentioned), "all".
DISCORD_ALLOW_BOTS=none

# Persistence and workspace
# SQLite connection URL. Parent directories must already exist. The Docker
# Compose configuration stores this database in the mounted /app/data directory.
DATABASE_URL=sqlite://omon_gateway.db

# Root directory available to terminal and file tools. When this variable is
# unset, the gateway creates and uses $HOME/.omon/workspace. Restrict the chosen
# path to data the agent is permitted to access.
# OMON_WORKSPACE_ROOT=$HOME/.omon/workspace

# Optional colon-separated list of additional absolute directory paths authorized
# for terminal and file tool access. When unset or empty, defaults to the user's
# HOME directory ($HOME). The primary workspace root is always authorized.
# Approval policies and hardline command guards still apply to all authorized paths.
# OMON_TOOL_ROOTS=/Users/user/documents:/Users/user/code/project

# Hermes integration and migration
# Hermes installation root used by `omon-gateway migrate`, cron synchronization,
# and Hermes skill discovery. When unset, the gateway uses $HOME/.hermes.
# HERMES_HOME=$HOME/.hermes

# Optional comma-separated Hermes cron profile names. When unset, the gateway
# synchronizes the default store plus profile directories discovered under
# $HERMES_HOME/profiles.
# OMON_HERMES_PROFILES=default,advisor,marketer

# Timeout in seconds for cron script execution (default 1800 / 30m).
# Can also be overridden per job via the `timeout_seconds` or `timeout` field.
# OMON_CRON_SCRIPT_TIMEOUT_SECS=1800

# When true, persistent memory and skill writes are staged to pending_writes table
# and require approval via /memory or /skills slash commands before being applied (default false).
WRITE_APPROVAL=false

# APPROVAL_MODE is enforced by the terminal SmartApprovalGuard. "smart" requests
# Web Dashboard Configuration
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9119

# Seconds to wait for a Discord command approval before the request expires
# (default 900).
APPROVAL_TIMEOUT_SECS=900

# Optional comma-separated wildcard glob patterns for commands that are unconditionally denied
# (e.g. "npm publish *,kubectl delete *"). Evaluated before policy, YOLO, or allowlists.
APPROVALS_DENY=

# When true, @-mentions allowed users (<@uid>) on approval prompts for push notifications
# (default false).
DISCORD_APPROVAL_MENTIONS=false

# External Security Scanner (Tirith)
# Optional HTTP URL to an external Tirith semantic risk scanner endpoint.
# When set, candidate terminal commands are scanned before execution.
# TIRITH_SCANNER_URL=http://127.0.0.1:8080/scan

# When true (default), permits command execution if external scanner is unreachable or times out.
# Set to false to fail closed (block commands if scanner fails).
# TIRITH_FAIL_OPEN=true

# Timeout in seconds for external scanner requests (default 5).
# TIRITH_TIMEOUT_SECS=5
