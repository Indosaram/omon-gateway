# Omon Gateway configuration
# Copy this file to .env and replace placeholder values. Never commit .env.

# Discord
# A token from the Discord Developer Portal. Required unless
# DISCORD_BOT_TOKENS provides at least one token.
DISCORD_BOT_TOKEN=replace-with-your-discord-bot-token

# Optional comma-separated bot tokens. Each identity runs in the same process,
# enabling parallel multi-bot sharding. Tokens from both settings are combined.
DISCORD_BOT_TOKENS=

# Optional comma-separated Discord user IDs. When empty, all users may interact
# with the gateway. Set this in shared or public servers.
DISCORD_ALLOWED_USERS=

# Optional comma-separated channel IDs where the bot responds without a mention.
# Direct messages and thread messages are handled automatically.
DISCORD_FREE_RESPONSE_CHANNELS=

# Optional comma-separated home channel IDs. Home channels are also treated as
# free-response channels.
DISCORD_HOME_CHANNEL=

# When true, @-mentions in guild text channels automatically create a public
# thread and route the conversation there (default false).
DISCORD_AUTO_THREAD=false

# LLM
# Required model identifier. Models beginning with "claude" use the Anthropic
# provider; all other model names use the OpenAI-compatible provider.
DEFAULT_MODEL=gpt-4o

# Optional OpenAI-compatible API endpoint. Leave empty for the provider default.
OPENAI_API_BASE=https://api.openai.com/v1

# OpenAI or OpenAI-compatible API key. Required when the selected provider needs
# bearer-token authentication.
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional Anthropic API endpoint. Leave empty for the provider default.
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Anthropic API key. Required when DEFAULT_MODEL begins with "claude".
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Persistence and workspace
# SQLite connection URL. Parent directories must already exist. The Docker
# Compose configuration stores this database in the mounted /app/data directory.
DATABASE_URL=sqlite://omon_gateway.db

# Root directory available to terminal and file tools. When this variable is
# unset, the gateway creates and uses $HOME/.omon/workspace. Restrict the chosen
# path to data the agent is permitted to access.
# OMON_WORKSPACE_ROOT=$HOME/.omon/workspace

# Hermes integration and migration
# Hermes installation root used by `omon-gateway migrate`, cron synchronization,
# and Hermes skill discovery. When unset, the gateway uses $HOME/.hermes.
# HERMES_HOME=$HOME/.hermes

# Optional comma-separated Hermes cron profile names. When unset, the gateway
# synchronizes the default store plus profile directories discovered under
# $HERMES_HOME/profiles.
# OMON_HERMES_PROFILES=default,advisor,marketer

# APPROVAL_MODE is enforced by the terminal SmartApprovalGuard. "smart" requests
# Discord-button approval for dangerous commands, "always" requests approval for
# every command, and "never" or "yolo" bypasses approval.
APPROVAL_MODE=smart

# Seconds to wait for a Discord command approval before the request expires
# (default 900).
APPROVAL_TIMEOUT_SECS=900

